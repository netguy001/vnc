# ============================================================
# ServerConsole Environment Configuration (.env)
# ============================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Backend Server Configuration
PORT=3001
# Listen on loopback by default. Use 0.0.0.0 only behind a TLS reverse proxy (Docker sets this itself).
HOST=127.0.0.1

# Frontend URL (for CORS and WebSocket origin verification)
FRONTEND_URL=http://localhost:5173

# Cryptography & Security Secrets
# MASTER_KEY must be a 64-character hex string (32 bytes) used for AES-256-GCM credential encryption
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for Session Authentication
JWT_SECRET=server_console_super_secret_jwt_key_change_in_production_min_32_chars!

# SQLite Database File Path
DATABASE_PATH=./data/server_console.sqlite

# Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Background telemetry sampling interval in seconds (minimum 15)
METRICS_INTERVAL_SEC=60

# Set to true when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false

# Optional: enables the AI health assistant (sends redacted server snapshots to the Anthropic API)
ANTHROPIC_API_KEY=
